# Copy to .env and fill in. .env is gitignored; never commit real values.

# The number after leagueId= in your ESPN league URL
ESPN_LEAGUE_ID=

# Cookies from a logged-in espn.com browser session (they expire now and then)
ESPN_S2=
ESPN_SWID=

# Your team's id within the league
DYNASTY_MY_TEAM_ID=

# Folder for the database and raw data. Use a folder outside OneDrive.
DYNASTY_DATA_DIR=
